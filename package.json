{
  "name": "qlsv-backend",
  "version": "0.1.0",
  "private": true,
  "description": "QLSV student management backend",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.4.3"
    }
  },
  "scripts": {
    "build": "nest build",
    "db:migrate": "node scripts/prisma-tool.cjs deploy",
    "db:migrate:deploy": "node scripts/prisma-tool.cjs deploy",
    "db:seed": "node scripts/seed.cjs",
    "format": "prettier --write \"{src,test}/**/*.ts\" \"scripts/**/*.cjs\" \"*.{js,json,md,yaml}\" \"docs/Backend_Implementation_Progress.md\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\" \"scripts/**/*.cjs\" \"*.{js,json,md,yaml}\" \"docs/Backend_Implementation_Progress.md\"",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "jest --config jest.config.js --runInBand",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand",
    "test:integration": "jest --config test/jest-integration.config.js --runInBand",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:e2e && npm run build",
    "check:db": "npm run db:migrate:deploy && npm run db:seed && npm run test:integration"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "ioredis": "6.0.0",
    "joi": "18.2.9",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.0.1",
    "globals": "17.13.0",
    "jest": "29.7.0",
    "prettier": "3.9.0",
    "prisma": "6.19.3",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
