generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  INVITED  @map("invited")
  ACTIVE   @map("active")
  LOCKED   @map("locked")
  DISABLED @map("disabled")

  @@map("user_status")
}

enum ChallengePurpose {
  INVITE         @map("invite")
  RESET_PASSWORD @map("reset_password")
  VERIFY_EMAIL   @map("verify_email")

  @@map("challenge_purpose")
}

enum ActorType {
  USER   @map("user")
  SYSTEM @map("system")

  @@map("actor_type")
}

model User {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String              @db.VarChar(254)
  emailNormalized    String              @unique(map: "users_email_normalized_key") @map("email_normalized") @db.VarChar(254)
  passwordHash       String?             @map("password_hash")
  status             UserStatus          @default(INVITED)
  emailVerifiedAt    DateTime?           @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt        DateTime?           @map("last_login_at") @db.Timestamptz(6)
  authVersion        Int                 @default(1) @map("auth_version")
  mustChangePassword Boolean             @default(false) @map("must_change_password")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  version            Int                 @default(1)
  deletedAt          DateTime?           @map("deleted_at") @db.Timestamptz(6)
  userRoles          UserRole[]
  sessions           AuthSession[]
  challenges         AuthChallenge[]
  auditLogs          AuditLog[]          @relation("AuditActor")
  idempotencyRecords IdempotencyRecord[]

  @@index([status, deletedAt], map: "users_status_deleted_at_idx")
  @@map("users")
}

model Role {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String           @unique @db.VarChar(30)
  name            String           @db.VarChar(100)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String           @unique @db.VarChar(100)
  description     String           @db.VarChar(255)
  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId], map: "user_roles_role_id_idx")
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "role_permissions_permission_id_idx")
  @@map("role_permissions")
}

model AuthSession {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  expiresAt     DateTime       @map("expires_at") @db.Timestamptz(6)
  lastUsedAt    DateTime       @default(now()) @map("last_used_at") @db.Timestamptz(6)
  revokedAt     DateTime?      @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?        @map("revoked_reason") @db.VarChar(100)
  userAgent     String?        @map("user_agent") @db.VarChar(512)
  ipHash        String?        @map("ip_hash") @db.VarChar(128)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  version       Int            @default(1)
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt, expiresAt], map: "auth_sessions_user_state_idx")
  @@map("auth_sessions")
}

model RefreshToken {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId    String        @map("session_id") @db.Uuid
  tokenHash    String        @unique(map: "refresh_tokens_token_hash_key") @map("token_hash") @db.VarChar(128)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime      @map("expires_at") @db.Timestamptz(6)
  consumedAt   DateTime?     @map("consumed_at") @db.Timestamptz(6)
  revokedAt    DateTime?     @map("revoked_at") @db.Timestamptz(6)
  replacedById String?       @unique(map: "refresh_tokens_replaced_by_id_key") @map("replaced_by_id") @db.Uuid
  session      AuthSession   @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  replacedBy   RefreshToken? @relation("RefreshTokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     RefreshToken? @relation("RefreshTokenRotation")

  @@index([sessionId, expiresAt], map: "refresh_tokens_session_expires_idx")
  @@map("refresh_tokens")
}

model AuthChallenge {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   ChallengePurpose
  tokenHash String           @unique(map: "auth_challenges_token_hash_key") @map("token_hash") @db.VarChar(128)
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, purpose, usedAt, expiresAt], map: "auth_challenges_user_purpose_state_idx")
  @@map("auth_challenges")
}

model AuditLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?   @map("actor_user_id") @db.Uuid
  actorType   ActorType @map("actor_type")
  action      String    @db.VarChar(100)
  entityType  String    @map("entity_type") @db.VarChar(50)
  entityId    String?   @map("entity_id") @db.Uuid
  beforeData  Json?     @map("before_data")
  afterData   Json?     @map("after_data")
  reason      String?
  requestId   String    @map("request_id") @db.Uuid
  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  ipHash      String?   @map("ip_hash") @db.VarChar(128)
  actor       User?     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, occurredAt], map: "audit_logs_entity_occurred_idx")
  @@index([actorUserId, occurredAt], map: "audit_logs_actor_occurred_idx")
  @@index([occurredAt, id], map: "audit_logs_cursor_idx")
  @@map("audit_logs")
}

model OutboxEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(100)
  aggregateId   String    @map("aggregate_id") @db.Uuid
  schemaVersion Int       @default(1) @map("schema_version")
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastErrorCode String?   @map("last_error_code") @db.VarChar(100)

  @@index([processedAt, nextAttemptAt, createdAt], map: "outbox_events_pending_idx")
  @@map("outbox_events")
}

model IdempotencyRecord {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  route          String   @db.VarChar(200)
  idempotencyKey String   @map("idempotency_key") @db.VarChar(100)
  requestHash    String   @map("request_hash") @db.Char(64)
  responseStatus Int      @map("response_status") @db.SmallInt
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, route, idempotencyKey], map: "idempotency_records_scope_key")
  @@index([expiresAt], map: "idempotency_records_expires_at_idx")
  @@map("idempotency_records")
}
