NODE_ENV=development
PORT=3000
APP_NAME=qlsv-backend
API_PREFIX=api/v1
LOG_LEVEL=info
DATABASE_URL=postgresql://qlsv:qlsv_dev_only@localhost:5432/qlsv?schema=public
REDIS_URL=redis://localhost:6379/0
# Generate a 2048-bit RSA pair and provide PEM newlines as literal \n in a single-line value.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=qlsv-web
